#!/bin/bash

ARGS=()
[ -d /mnt/wslg ] && ARGS+=(-selection clipboard)

[ 0 = $# ] && set -- catter

catter()
{
  printf '%q\n' "$@" || exit
}

show='|/-\'
cnt=0
draw=0

last=
while   ! keypressed 500
do
	let draw++
	printf '\r%q%d%c' "$ret" "$cnt" "${show:$[draw%4]:1}" >&2
	get="$(timeout 10 xclip "${ARGS[@]}" -out 2>&1)"
	ok=$?
	[ ".$get" = ".$last" ] && continue
	last="$get"
	[ 0 = $ok ] || { printf 'ERR %q\n' "$get" >&2; continue; }

	let cnt++
	"$@" "$get"
	ret=$?
done

