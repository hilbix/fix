#!/bin/bash

ARGS=()
[ -d /mnt/wslg ] && ARGS+=(-selection clipboard)

[ 0 = $# ] && set -- catter

catter()
{
  if	read x <<<"$*" && [ ".$x" = ".$*" ]
  then
	printf '%s\n' "$@"
  else
	printf '%q\n' "$@"
  fi || exit
}

show='|/-\'
cnt=0
draw=0

last=
while   ! read -N1 -t0.5
do
	let draw++
	printf '\r%q%d%c' "$ret" "$cnt" "${show:$[draw%4]:1}" >&2
	get="$(timeout 10 xclip "${ARGS[@]}" -out 2>&1)"
	ok=$?
	[ ".$get" = ".$last" ] && continue
	last="$get"
	[ 0 = $ok ] || { printf 'ERR %q\n' "$get" >&2; continue; }

	let cnt++
	"$@" "$get"
	ret=$?
done

